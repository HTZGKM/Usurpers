# Set in the hosting environment; never commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
USURPERS_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
USURPERS_HTTPS=1
USURPERS_PUBLIC_URL=https://doubleportion-usurpers.vercel.app

# Verified email recovery requires a real SMTP account.
USURPERS_SMTP_HOST=
USURPERS_SMTP_PORT=587
USURPERS_SMTP_FROM=
USURPERS_SMTP_USER=
USURPERS_SMTP_PASSWORD=
USURPERS_SMTP_TLS=starttls
